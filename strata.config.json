{
  "name": "strata-sample-platform",
  "services": [
    { "name": "gateway", "path": "gateway" },
    { "name": "user", "path": "services/user" },
    { "name": "catalog", "path": "services/catalog" },
    { "name": "inventory", "path": "services/inventory" },
    { "name": "payment", "path": "services/payment" },
    { "name": "order", "path": "services/order" },
    { "name": "notification", "path": "services/notification" },
    { "name": "shipping", "path": "services/shipping" },
    { "name": "search", "path": "services/search" },
    { "name": "graphql-gateway", "path": "graphql/gateway" },
    { "name": "graphql-users", "path": "graphql/subgraphs/users" },
    { "name": "graphql-orders", "path": "graphql/subgraphs/orders" },
    { "name": "graphql-catalog", "path": "graphql/subgraphs/catalog" },
    { "name": "web", "path": "web" }
  ],
  "forbidden": [
    {
      "name": "web は BFF/GraphQL 以外を直接叩かない",
      "from": "web",
      "to": "services/*",
      "comment": "フロントエンドは gateway か GraphQL スーパーグラフ経由に限定する"
    }
  ],
  "thresholds": {
    "maxCycles": 0
  }
}
